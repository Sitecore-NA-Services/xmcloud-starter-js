# This file should be copied to .env.local and modified with your environment variables to connect to your Sitecore container instance.

# To secure the Sitecore editor endpoint exposed by your Next.js app
# (`/api/editing/render` by default), a secret token is used. This (client-side)
SITECORE_EDITING_SECRET=

# Your Sitecore site name.
# The value of the variable represents the default/configured site.
NEXT_PUBLIC_DEFAULT_SITE_NAME=

# Your default app language.
NEXT_PUBLIC_DEFAULT_LANGUAGE=

# Your Sitecore API key is needed to build the app.
NEXT_PUBLIC_SITECORE_API_KEY=

# Your Sitecore API hostname is needed to build the app.
NEXT_PUBLIC_SITECORE_API_HOST=

# Sitecore Content SDK npm packages utilize the debug module for debug logging.
# https://www.npmjs.com/package/debug
# Set the DEBUG environment variable to 'content-sdk:*' to see all logs:
#DEBUG=content-sdk:*
# Or be selective and show for example only layout service logs:
#DEBUG=content-sdk:layout
# Or everything BUT layout service logs:
#DEBUG=content-sdk:*,-content-sdk:layout

# ---------------------------------------------------------------------------
# Azure OpenAI (used by /api/chat/agent and /api/chat/rag for the Agent Chat
# and RAG Chat renderings). Leave blank to leave those renderings unconfigured.
# ---------------------------------------------------------------------------

# Azure OpenAI resource name, i.e. the <name> in https://<name>.openai.azure.com.
AZURE_OPENAI_RESOURCE_NAME=

# Key from Azure Portal > your Azure OpenAI resource > Keys and Endpoint.
AZURE_OPENAI_API_KEY=

# Name of the chat *deployment* (not the model name) in Azure AI Foundry.
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna

AZURE_OPENAI_API_VERSION=2024-10-21

# Reasoning models (gpt-5.x, o-series) reject temperature/top_p/max_tokens and
# need max_completion_tokens instead; src/lib/azure-openai.ts rewrites those
# params when this is true. Leave blank to infer it from the deployment name.
#AZURE_OPENAI_REASONING_MODEL=true

# Deployment name for an embedding model (e.g. text-embedding-3-small), used to
# rerank Sitecore Search results by relevance for the Agent Chat and RAG Chat demos.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Minimum cosine similarity (0-1) a search result must meet to be used as RAG
# context / shown as a relevant source. Tune based on observed score distribution.
RAG_RELEVANCE_THRESHOLD=0.45
