# This file should be copied to .env.local and modified with your environment variables to connect to your remote Sitecore instance.

# To secure the Sitecore editor endpoint exposed by your Next.js app
# (`/api/editing/render` by default), a secret token is used. This (client-side)
SITECORE_EDITING_SECRET=

# Your Sitecore site name.
# The value of the variable represents the default/configured site.
NEXT_PUBLIC_DEFAULT_SITE_NAME=

# Your default app language.
NEXT_PUBLIC_DEFAULT_LANGUAGE=

# Optional: select the site language by domain.
# Comma-separated list of host=locale pairs. When a request's hostname matches an
# entry, that locale is used (URLs stay clean — no /<locale> prefix). Hosts not
# listed use the default language. Each locale must also be declared in
# src/i18n/routing.ts and enabled with content versions in XM Cloud.
# Example: LOCALE_DOMAIN_MAP=es.example.com=es-MX,fr.example.com=fr-FR
LOCALE_DOMAIN_MAP=

# Your unified Sitecore Edge Context Id for server-side use.
# This will be used over any Sitecore Preview / Delivery Edge variables (above).
SITECORE_EDGE_CONTEXT_ID=

# Your Sitecore Edge Context Id for client-side use.
# Will be used as a fallback if separate SITECORE_EDGE_CONTEXT_ID value is not provided
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=

# An optional Sitecore Personalize scope identifier.
# This can be used to isolate personalization data when multiple XM Cloud Environments share a Personalize tenant.
# This should match the PAGES_PERSONALIZE_SCOPE environment variable for your connected XM Cloud Environment.
NEXT_PUBLIC_PERSONALIZE_SCOPE=

# Optional: custom Sitecore Edge Platform hostname (hostname or full URL).
NEXT_PUBLIC_SITECORE_EDGE_PLATFORM_HOSTNAME=

# Optional: custom Experience Edge hostname for media URL rewriting (e.g. staging).
SITECORE_EXPERIENCE_EDGE_HOSTNAME=

# Timeout (ms) for Sitecore CDP requests to respond within. Default is 400.
PERSONALIZE_PROXY_CDP_TIMEOUT=

# Timeout (ms) for Sitecore Experience Edge requests to respond within. Default is 400.
PERSONALIZE_PROXY_EDGE_TIMEOUT=

# Sitecore Content SDK npm packages utilize the debug module for debug logging.
# https://www.npmjs.com/package/debug
# Set the DEBUG environment variable to 'content-sdk:*' to see all logs:
#DEBUG=content-sdk:*
# Or be selective and show for example only layout service logs:
#DEBUG=content-sdk:layout
# Or everything BUT layout service logs:
#DEBUG=content-sdk:*,-content-sdk:layout

# Client ID and Secret used for Design Library functionality
SITECORE_AUTH_CLIENT_ID=
SITECORE_AUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Sitecore Search — front-end (JS SDK for React) configuration.
# These are browser-exposed (NEXT_PUBLIC_*) on purpose: Sitecore Search is
# designed to be called from the client with a domain-scoped key, and the SDK
# uses them to authenticate, run queries, and track visitor events (analytics +
# personalization). Get the values from the Sitecore Search console (CEC):
#   Developer Resources  ->  API access / API keys.
# ---------------------------------------------------------------------------

# Search environment for your account: "prod" | "prodEu" | "apse2".
NEXT_PUBLIC_SEARCH_ENV=prod

# Customer key (a.k.a. customer/account key) from CEC > Developer Resources.
NEXT_PUBLIC_SEARCH_CUSTOMER_KEY=

# Public API key from CEC > Developer Resources.
NEXT_PUBLIC_SEARCH_API_KEY=

# rfkId of the Search Results widget configured in the Search console
# (used by the /search results page).
NEXT_PUBLIC_SEARCH_RESULTS_RFKID=

# rfkId of the Preview Search widget configured in the Search console
# (used by the header typeahead).
NEXT_PUBLIC_SEARCH_PREVIEW_RFKID=

# Locale sent on every request (the domain requires context.locale). Defaults to
# the domain default en/us; override only if your domain uses a different locale.
NEXT_PUBLIC_SEARCH_LANGUAGE=en
NEXT_PUBLIC_SEARCH_COUNTRY=us

# Scope results to this site's crawler source(s) — Sitecore Search > Sources.
# A Search domain has ONE shared index that all sources feed; the recommended
# multi-site pattern is "one source per site" + filtering by source. Comma-
# separated source IDs; leave empty to return results from all sources.
NEXT_PUBLIC_SEARCH_SOURCE_IDS=
