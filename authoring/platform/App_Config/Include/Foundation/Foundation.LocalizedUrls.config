<?xml version="1.0" encoding="utf-8"?>
<!--
  Enables display-name based URL generation so Sitecore resolves and generates
  page URLs from the item Display Name field instead of the item name.
  This allows content authors to set localized URL slugs per language.

  Two changes:
  1. Patch the built-in "sitecore" link provider with useDisplayName="true"
     so that all sites (including solterra) resolve display-name paths by default.
  2. Register "customLocalizedProvider" for sites that explicitly opt-in via
     their Site Grouping "Link provider name" field.

  After deploying, do a full site publish to rebuild routes.
  Ref: https://doc.sitecore.com/sai/en/developers/content-sdk/route-handling-and-data-fetching-in-content-sdk-apps.html#configure-display-name-based-routing
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <linkManager>
      <providers>
        <!-- Patch the default sitecore provider to use display names -->
        <add name="sitecore">
          <patch:attribute name="useDisplayName">true</patch:attribute>
        </add>
        <!-- Named provider for explicit site opt-in via Site Grouping -->
        <add name="customLocalizedProvider"
             type="Sitecore.XA.Foundation.Multisite.LinkManagers.LocalizableLinkProvider, Sitecore.XA.Foundation.Multisite"
             cacheExpiration="5"
             addAspxExtension="false"
             alwaysIncludeServerUrl="false"
             encodeNames="true"
             languageEmbedding="never"
             languageLocation="filePath"
             shortenUrls="true"
             useDisplayName="true" />
      </providers>
    </linkManager>
  </sitecore>
</configuration>
