<?xml version="1.0" encoding="utf-8"?>
<!--
  Enables display-name based URL generation so that Sitecore resolves and
  generates page URLs from the item's Display Name field instead of the item
  name.  This allows content authors to set localized URL slugs per language
  version without renaming the item.

  Ref: https://developers.sitecore.com/learn/accelerate/sitecoreai/implementation/information-architecture/localization#localized-urls
  Ref: https://doc.sitecore.com/sai/en/developers/content-sdk/route-handling-and-data-fetching-in-content-sdk-apps.html#configure-display-name-based-routing
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>

    <!--
      Patch the built-in localizedProvider (used by SXA multisite) to resolve
      URLs from Display Name instead of item name.
    -->
    <linkManager>
      <providers>
        <add name="localizedProvider">
          <patch:attribute name="useDisplayName">true</patch:attribute>
        </add>
      </providers>
    </linkManager>

    <!--
      Also patch the urlBuilder so that internal link generation uses
      Display Name (covers Link fields rendered by the Link Manager).
    -->
    <links>
      <urlBuilder>
        <useDisplayName>true</useDisplayName>
      </urlBuilder>
    </links>

  </sitecore>
</configuration>
