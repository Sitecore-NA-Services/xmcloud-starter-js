            },
            {
                "name": "ll.renderings",
                "path": "/sitecore/layout/Renderings/Project/lighthouse",
                "allowedPushOperations": "CreateUpdateAndDelete"
            },
            {
                "name": "ll.branches",
                "path": "/sitecore/templates/Branches/Project/lighthouse",
                "allowedPushOperations": "CreateUpdateAndDelete"
            },
            {
                "name": "ll.layouts",
                "path": "/sitecore/layout/Layouts/Project/lighthouse",
                "allowedPushOperations": "CreateUpdateAndDelete"
            },
            {
                "name": "ll.media.parent",
                "path": "/sitecore/media library/Project/Demo Shared SXA Sites",
