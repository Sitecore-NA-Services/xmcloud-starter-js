                "allowedPushOperations": "CreateAndUpdate"
            },
            {
                "name": "ll.site-template",
                "path": "/sitecore/system/Settings/Feature/JSS Experience Accelerator/Lighthouse Lifestyle",
                "scope": "ItemAndDescendants",
                "allowedPushOperations": "CreateUpdateAndDelete"
            },
            {
                "name": "ll.spe-scripts",
